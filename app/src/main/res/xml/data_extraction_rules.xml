<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="idmuslim_wallet_vault.db" />
        <exclude domain="database" path="idmuslim_wallet_vault.db-wal" />
        <exclude domain="database" path="idmuslim_wallet_vault.db-shm" />
        <exclude domain="file" path="encrypted_vault_docs" />
        <exclude domain="sharedpref" path="idmuslim_sqlcipher_wallet_prefs.xml" />
        <exclude domain="sharedpref" path="idmuslim_ecc_keystore_prefs.xml" />

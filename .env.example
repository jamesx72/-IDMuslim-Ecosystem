# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
WALLET_TOKEN=YOUR_WALLET_TOKEN
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID
PAYPAL_EMERALD_MONTHLY_PLAN_ID=YOUR_PAYPAL_EMERALD_MONTHLY_PLAN_ID
PAYPAL_EMERALD_ANNUAL_PLAN_ID=YOUR_PAYPAL_EMERALD_ANNUAL_PLAN_ID
PAYPAL_WAQF_MONTHLY_PLAN_ID=YOUR_PAYPAL_WAQF_MONTHLY_PLAN_ID
PAYPAL_WAQF_ANNUAL_PLAN_ID=YOUR_PAYPAL_WAQF_ANNUAL_PLAN_ID



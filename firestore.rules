rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'ouattarajamesx@gmail.com' ||
        request.auth.token.firebase.sign_in_provider == 'custom'
      );
    }

    // 1. User Profiles & Digital Identity Documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      
      // Allow updates for profile data, but restrict critical security fields from client-side tampering
      allow update: if isAdmin() || (
        isOwner(userId) &&
        // Prevent users from directly un-suspending or overriding admin restrictions
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isRevoked',
          'isSuspended',
          'suspensionReason',
          'adminAuditLog'
        ])
      );
      
      allow delete: if isOwner(userId) || isAdmin();

      // User's private Payments & Invoices Subcollection (Stripe, PayPal, Crypto)
      match /payments/{paymentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && 
                         request.resource.data.amount is number && 
                         request.resource.data.amount >= 0;
        allow update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin();
      }

      // User's Activity & Security Audit Logs
      match /activity_logs/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // User's Family Pack Sub-identities
      match /family_members/{memberId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User's Digital Passports / Certificates
      match /documents/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Stripe & PayPal Webhook Events (Secure Cloud Trigger Pipeline)
    match /stripe_events/{eventId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /webhook_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 3. Payment Intents & Checkout Sessions Collection
    match /payment_intents/{intentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.amount is number;
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 4. Mosques & Halal Places (Public read, verified write)
    match /mosques/{mosqueId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (
        isAuthenticated() && resource.data.createdBy == request.auth.uid
      );
    }

    // 5. Emergency Declarations & SOS Broadcasts
    match /emergency_declarations/{declId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
    }

    // 6. Identity Verification Requests
    match /verification_requests/{reqId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}

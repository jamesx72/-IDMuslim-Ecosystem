rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // End-to-end client-encrypted identity PDFs and images (.enc ECIES ciphertext only)
    match /encrypted_documents/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 16 * 1024 * 1024
                   && request.resource.contentType == 'application/octet-stream';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /user_docs/{userId}/{allPaths=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /verification_docs/{userId}/{allPaths=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
